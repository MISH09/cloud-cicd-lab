pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out from GitHub'
            }
        }

        stage('Build') {
            steps {
                echo 'Building Student Service application'
            }
        }

        stage('Test') {
            steps {
                sh 'test -f app.py'
                sh 'test -f requirements.txt'
                echo 'Application files verified'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t student-service:latest -f dockerfile .'
            }
        }

        stage('Deploy') {
            steps {
                sh 'docker rm -f student-container || true'
                sh 'docker run -d --name student-container --restart unless-stopped -p 5000:5000 student-service:latest'
                sh 'sleep 3'
                sh 'curl -fsS http://localhost:5000/'
                sh 'curl -fsS http://localhost:5000/student'
            }
        }
    }
}
